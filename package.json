{
  "name": "cryptorecovery",
  "version": "1.0.0",
  "description": "Crypto Recovery Helpdesk - React + TypeScript SPA built with esbuild and Tailwind",
  "main": "index.js",
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.1",
    "react-hook-form": "^7.45.1",
    "zod": "^3.22.2",
    "lucide-react": "^0.268.0",
    "i18next": "^23.0.1",
    "class-variance-authority": "^1.2.1",
    "date-fns": "^3.6.0",
    "react-day-picker": "^8.10.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "esbuild": "^0.19.4",
    "esbuild-style-plugin": "^2.0.0",
    "postcss": "^8.4.34",
    "tailwindcss": "^3.5.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.50.0",
    "postcss-cli": "^10.1.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:css": "npx tailwindcss -i src/main.css -o dist/main.css --minify",
